                            </layout>
                          </widget>
                          <widget class="QWidget" name="exclusionsTab">
                            <attribute name="title"><string>排除文件</string></attribute>
                            <layout class="QVBoxLayout" name="exclusionsLayout">
                              <item><widget class="QLabel" name="exclusionsHelp">
                                <property name="text"><string>基本同步和附加规则选出的文件都经过排除名单。多项用分号或换行分隔。</string></property>
                                <property name="wordWrap"><bool>true</bool></property>
                              </widget></item>
                              <item><widget class="QLabel" name="wildcardHelp">
                                <property name="role" stdset="0"><string>muted</string></property>
                                <property name="text"><string>* 匹配零个或多个字符，? 匹配恰好一个字符。</string></property>
                                <property name="wordWrap"><bool>true</bool></property>
                              </widget></item>
                              <item><layout class="QHBoxLayout" name="exclusionsEditor" stretch="1,0">
                                <item><widget class="QPlainTextEdit" name="exclusionsEdit">
                                  <property name="accessibleName"><string>排除名单</string></property>
                                  <property name="placeholderText"><string>例如 a.dll; *.pdb; log?.txt</string></property>
                                </widget></item>
                                <item><layout class="QVBoxLayout" name="exclusionsButtons">
                                  <item><widget class="QPushButton" name="applyExclusionsButton"><property name="text"><string>保存排除规则</string></property></widget></item>
