                </item>
                <item>
                  <widget class="QGroupBox" name="hostEditorGroup">
                    <property name="title">
                      <string>远程主机编辑</string>
                    </property>
                    <layout class="QVBoxLayout" name="hostEditorLayout">
                      <item>
                        <layout class="QGridLayout" name="hostForm" columnstretch="0,1,0,1">
                          <property name="horizontalSpacing"><number>12</number></property>
                          <item row="0" column="0">
                            <widget class="QLabel" name="pathLabel">
                              <property name="text">
                                <string>共享目录</string>
