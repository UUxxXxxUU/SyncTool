    <widget class="QMenuBar" name="menubar">
      <widget class="QMenu" name="settingsMenu">
        <property name="title"><string>设置(&amp;S)</string></property>
        <addaction name="autoSyncAction" />
        <addaction name="separator" />
        <addaction name="preferencesAction" />
        <addaction name="saveConfigAction" />
      </widget>
      <widget class="QMenu" name="helpMenu">
        <property name="title"><string>帮助(&amp;H)</string></property>
        <addaction name="usageTipsAction" />
        <addaction name="checkUpdatesAction" />
      </widget>
      <widget class="QMenu" name="toolsMenu">
        <property name="title"><string>工具(&amp;T)</string></property>
        <addaction name="remoteDebuggerAction" />
        <addaction name="diagnosticsAction" />
      </widget>
      <addaction name="settingsMenu" />
      <addaction name="toolsMenu" />
      <addaction name="helpMenu" />
    </widget>
    <widget class="QStatusBar" name="statusbar">
      <widget class="QWidget" name="statusControls">
        <layout class="QHBoxLayout" name="statusLayout">
          <property name="leftMargin">
            <number>0</number>
          </property>
          <property name="topMargin">
            <number>0</number>
          </property>
          <property name="rightMargin">
            <number>0</number>
          </property>
          <property name="bottomMargin">
            <number>0</number>
          </property>
          <item><widget class="QLabel" name="settingsSummaryLabel">
            <property name="text"><string>自动同步：关闭 · 扫描间隔：5 秒</string></property>
            <property name="textFormat"><enum>Qt::RichText</enum></property>
            <property name="toolTip"><string>点击打开偏好设置</string></property>
            <property name="textInteractionFlags"><set>Qt::LinksAccessibleByKeyboard|Qt::LinksAccessibleByMouse</set></property>
          </widget></item>
          <item><widget class="QLabel" name="updateNoticeLabel">
            <property name="visible"><bool>false</bool></property>
            <property name="text"><string /> </property>
            <property name="textFormat"><enum>Qt::RichText</enum></property>
            <property name="textInteractionFlags"><set>Qt::LinksAccessibleByKeyboard|Qt::LinksAccessibleByMouse</set></property>
          </widget></item>
          <item><widget class="QLabel" name="uptimeLabel">
            <property name="text"><string>运行 00:00:00</string></property>
            <property name="toolTip"><string>本次启动后的持续运行时长</string></property>
          </widget></item>
        </layout>
      </widget>
    </widget>
    <action name="autoSyncAction">
      <property name="checkable"><bool>true</bool></property>
      <property name="text"><string>自动同步</string></property>
      <property name="toolTip"><string>检测到本地文件变化后自动同步</string></property>
    </action>
    <action name="preferencesAction">
      <property name="text"><string>偏好设置...</string></property>
      <property name="shortcut"><string>Ctrl+,</string></property>
    </action>
    <action name="saveConfigAction">
      <property name="text"><string>保存配置</string></property>
      <property name="shortcut"><string>Ctrl+S</string></property>
    </action>
    <action name="checkUpdatesAction">
      <property name="text"><string>检查更新...</string></property>
    </action>
    <action name="remoteDebuggerAction"><property name="text"><string>远程调试器…</string></property></action>
    <action name="diagnosticsAction"><property name="text"><string>打开诊断目录</string></property></action>
    <action name="usageTipsAction">
