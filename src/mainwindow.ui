                  <number>10</number>
                </property>
                <item>
                  <widget class="QGroupBox" name="localGroup">
                    <property name="title">
                      <string>本地目录与同步规则</string>
                    </property>
                    <layout class="QVBoxLayout" name="localLayout">
                      <item>
                        <layout class="QHBoxLayout" name="dirLayout" stretch="0,1,0,0,0,0">
