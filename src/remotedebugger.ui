        <item><widget class="QLabel" name="remoteHint">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>使用已保存主机的账号密码，工具版本和架构在下方选择。安装成功后默认开启自启并启动调试器；无需用户登录。关闭自启不会停止当前运行的调试器。无认证模式仅限可信局域网。</string></property>
        </widget></item>
        <item><widget class="QLabel" name="credentialHint">
