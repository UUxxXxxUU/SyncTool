      <item><widget class="QGroupBox" name="argumentsGroup">
       <property name="title"><string>msvsmon.exe 启动参数</string></property>
       <layout class="QVBoxLayout" name="argumentsLayout">
        <item><layout class="QHBoxLayout" name="argumentsCopyLayout" stretch="1,0">
         <item><widget class="QLineEdit" name="argumentsEdit">
          <property name="readOnly"><bool>true</bool></property>
          <property name="accessibleName"><string>远程调试器启动参数</string></property>
         </widget></item>
         <item><widget class="QPushButton" name="copyArgumentsButton"><property name="text"><string>复制参数</string></property></widget></item>
        </layout></item>
        <item><widget class="QLabel" name="argumentDetails">
         <property name="textFormat"><enum>Qt::RichText</enum></property>
         <property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>&lt;table cellspacing="3" cellpadding="2"&gt;
&lt;tr&gt;&lt;td&gt;&lt;tt&gt;/noauth&lt;/tt&gt;&lt;/td&gt;&lt;td&gt;使用无身份验证模式。&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;tt&gt;/anyuser&lt;/tt&gt;&lt;/td&gt;&lt;td&gt;跳过用户名检查，允许任意用户连接。&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;tt&gt;/nosecuritywarn&lt;/tt&gt;&lt;/td&gt;&lt;td&gt;关闭无身份验证模式的安全提示。&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;tt&gt;/port 4026&lt;/tt&gt;&lt;/td&gt;&lt;td&gt;将主监听端口设为 TCP 4026。&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;tt&gt;/timeout 999999999&lt;/tt&gt;&lt;/td&gt;&lt;td&gt;无人连接时，等待 999999999 秒后退出。&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;</string></property>
        </widget></item>
        <item><widget class="QLabel" name="argumentScope">
         <property name="role" stdset="0"><string>muted</string></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>这组参数用于隔离的测试网络。</string></property>
        </widget></item>
       </layout>
      </widget></item>
