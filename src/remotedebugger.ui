         <item><widget class="QPushButton" name="enableRemoteStartupButton"><property name="text"><string>开启自启</string></property></widget></item>
         <item><widget class="QPushButton" name="disableRemoteStartupButton"><property name="text"><string>关闭自启</string></property></widget></item>
